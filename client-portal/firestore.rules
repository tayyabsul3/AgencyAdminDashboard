rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WordPress connections - user can only access their own
    match /users/{userId}/wordpressConnections/{connectionId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // Allow all access for other collections (testing - remove in production)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}