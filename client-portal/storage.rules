rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to generated images
    match /generated-images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default rule for other files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
